# Dados brutos e derivados (zips, txt, csv) -- grandes, reprodutiveis pelo pipeline.
# "data/*" (nao "data/") para permitir excecoes pontuais abaixo -- um diretorio
# ignorado por inteiro bloqueia re-inclusao de arquivo dentro dele.
data/*

# Excecoes: dado de referencia pequeno, com correcoes manuais documentadas
# (nao dump bruto reproduzivel 1:1 so por rede) -- ver src/SRC_001_enriquecer_bases_aerodromos.py
!data/Bases_dos_microdados_2015_2026.txt
!data/aerodromos_enriquecido.csv
!data/aerodromos_sem_match.csv
# Recorte manual de 283 aerodromos fornecido pelo autor (pesquisa externa,
# nao reproduzivel por rede) -- fonte original da dimensao, citado por
# DEC-009 e SPEC-011. Veio de rascunho/ em 2026-09-05.
!data/dim_airport_location_time_zone.csv

# Banco local -- 2,5GB+, excede o limite de arquivo do GitHub (100MB) de qualquer forma
db/

# Extrato de dado bruto para organizacao local (54MB, 1,15M linhas) --
# reproduzivel a partir de basica_curated_deep, mesmo raciocinio do db/
analise/a4_etapa_media/dados_etapa_media_gol_2021_2026.csv

# Config local do Claude Code (permissões pessoais, não é parte do projeto)
.claude/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# SO
.DS_Store

# Extrato de dado bruto de block time (1,2GB) -- mesmo raciocinio do CSV de
# etapa media acima: reproduzivel a partir de fato_block_time_gol_azul
analise/a5_block_time/dados_block_time_gol_azul.csv

# Empacotamentos locais para transporte de arquivo (247MB e 204MB em partes).
# Acima do limite de 100MB por arquivo do GitHub, e conteudo ja versionado
# em analise/ e docs/
analise_anac.zip
rascunho/

# Bytecode do Python
__pycache__/

# Material de estudo de terceiros (site espelhado do r4ds, 787 arquivos):
